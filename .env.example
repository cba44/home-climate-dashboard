# Copy this file to .env.local and fill in your values.

# ── MQTT broker ─────────────────────────────────────────────────────────────
MQTT_HOST=localhost        # your Pi's hostname or IP
MQTT_PORT=1883
PORT=3000

# ── Notifications ────────────────────────────────────────────────────────────
# Set *_ENABLED=true to activate a service. All other vars for that service
# are required unless marked optional.

# ntfy (https://ntfy.sh or self-hosted)
NTFY_ENABLED=false
NTFY_URL=https://ntfy.sh   # optional: set to your self-hosted URL
NTFY_TOPIC=                # required when NTFY_ENABLED=true
NTFY_TOKEN=                # optional: Bearer token for access-controlled topics
NTFY_PRIORITY_ALERT=high       # priority for problem notifications (min/low/default/high/max)
NTFY_PRIORITY_RECOVERY=default # priority for "back to normal" notifications

# Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=        # from @BotFather
TELEGRAM_CHAT_ID=          # chat or group ID (use a negative number for groups)

# Discord
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=       # channel webhook URL

# Web Push (PWA)
# Generate keys once with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY must equal VAPID_PUBLIC_KEY — the NEXT_PUBLIC_ prefix
# is required so Next.js bakes it into the client bundle at build time.
VAPID_PUBLIC_KEY=              # server-side: used to sign outgoing push messages; also served to the browser at runtime via GET /api/vapid-public-key
VAPID_PRIVATE_KEY=             # server-side: keep secret, never commit
VAPID_SUBJECT=mailto:you@example.com  # contact URI sent with each push request
